				{
					"name": "Small",
					"size": "0.8rem",
					"slug": "sm"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "md"
				},
				{
					"name": "Large",
					"size": "1.875rem",
					"slug": "lg"
				},
				{
					"name": "XL",
					"size": "clamp(1.25rem, 1.25rem + ((1vw - 0.2rem) * 0.455), 1.5rem)",
					"slug": "xl"
				},
				{
					"name": "XXL",
					"size": "clamp(28px, 0.5rem + 5vw ,3.75rem)",
					"slug": "xxl"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxl)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			}
		},
		"color": {
			"background": "#ffffff",
			"text": "var(--wp--preset--color--primary)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif-4)",
					"fontSize": "var(--wp--preset--font-size--xxl)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lg)",
					"fontStyle": "normal",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		},
		"spacing": {
			"blockGap": "0px"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"lineHeight": 1.6
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
